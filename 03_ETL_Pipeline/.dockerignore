# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets — never bake these into an image
.env
.env.*
*.key
*credentials*.json
service-account*.json

# Data — mount as a volume instead of copying into the image
data/raw/*
data/processed/*
data/quality/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/quality/.gitkeep

# Version control
.git/
.gitignore

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Docker itself
Dockerfile
.dockerignore
docker-compose*.yml

# Project docs not needed inside the image
README.md